# Server & Database
PORT=3000
NODE_ENV=development
MONGODB_URI=
CLIENT_URL=http://localhost:3000

# JWT Secrets (auto-generated in-memory in dev if omitted; set strong secrets in production)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# TMDB API Proxy (optional - seeded cinema catalog works without it)
TMDB_API_KEY=

# Gmail SMTP for Welcome & Password Reset Emails (optional - logs preview in dev if omitted)
GMAIL_USER=
GMAIL_APP_PASSWORD=
